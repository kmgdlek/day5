# ── 서버 함수(/api/*)에서만 쓰는 비밀 값 ──────────────────────────
# (날씨는 Open-Meteo 를 쓰므로 키가 필요 없어요)
# 로컬: 이 파일을 .env 로 복사해서 값을 채우세요 (.env 는 GitHub 에 올라가지 않아요)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 등록하세요

# Pixabay 사진 검색 API 키 (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=여기에_키

# Supabase (Project Settings → API). 읽기 전용(anon) 키만 사용합니다.
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY 이름으로 이미 등록해 두었다면 그대로 써도 됩니다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
